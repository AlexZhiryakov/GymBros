# Скопируйте в .env локально. НЕ коммитьте реальные значения.
# На хостинге (Railway/Render/Oracle) задайте те же имена в Secrets / Variables.

# Telegram BotFather token (после утечки — обязательно Revoke и новый токен)
TOKEN=

# PostgreSQL (Neon или РФ-хостинг)
DB_NAME=GymBros
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Telegram user id владельца (админ-команды)
OWNER_ID=

# Django admin
SECRET_KEY=

# 152-ФЗ / публичные ссылки
PRIVACY_POLICY_URL=https://github.com/AlexZhiryakov/GymBros/blob/main/docs/legal/privacy-policy.md
OPERATOR_CONTACT=@gymbros_manager
CONSENT_VERSION=1.0

# Опционально
# NOTIFICATION_BOT_TOKEN=
# ADMIN_CHAT_ID=
